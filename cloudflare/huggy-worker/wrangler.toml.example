name = "huggy-worker"
main = "worker.js"
compatibility_date = "2026-06-21"

[vars]
# Use the public Space URL, not the repo URL.
# Example format: https://atleebugs-huggy.hf.space
HUGGY_SPACE_URL = "https://atleebugs-huggy.hf.space"
HUGGY_SECRET_HEADER = "x-huggy-secret"
ALLOWED_ORIGIN = "https://athulyaweerakoon.xyz"

# Daily fair-use budget. Defaults below assume every LLM request includes
# Huggy's always-included context, which costs about 1000 tokens / 552 words.
HUGGY_CONTEXT_WORDS = "552"
HUGGY_CONTEXT_TOKENS = "1000"
HUGGY_SHARED_DAILY_REQUESTS = "500"
HUGGY_FAIR_USER_COUNT = "20"
# Optional overrides. If omitted, the Worker allows 500 / 20 = 25
# requests per IP per UTC day and 6000 incoming payload words per IP per day.
# HUGGY_DAILY_REQUEST_LIMIT = "25"
# HUGGY_DAILY_PAYLOAD_WORD_LIMIT = "6000"

[[kv_namespaces]]
binding = "HUGGY_RATE_LIMIT_KV"
id = "replace-with-your-production-kv-namespace-id"
# preview_id is optional, but useful for `wrangler dev --remote`.
# preview_id = "replace-with-your-preview-kv-namespace-id"

# Set this as a secret, not a plain var:
# wrangler secret put HUGGY_CLOUDFLARE_SECRET
